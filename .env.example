# OpenAI API Configuration (for DALL-E 3 image generation)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# DALL-E Cost Limits (USD) - prevents runaway costs
# Daily limit: $5.00 (default) = ~62-125 images/day
# Monthly limit: $50.00 (default) = ~625-1250 images/month
DALLE_DAILY_LIMIT=5
DALLE_MONTHLY_LIMIT=50

# Reddit API Configuration
# Get your API credentials at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=news-radar:v0.1.0 (by /u/your_username)

# Optional: Reddit account credentials (for authenticated requests)
# REDDIT_USERNAME=your_username
# REDDIT_PASSWORD=your_password

# Substack Publishing Configuration
# Note: Substack doesn't have an official API, so we use browser automation
# You must enable password login in your Substack account settings first:
# 1. Go to https://substack.com/sign-in
# 2. Click "Sign in with password"
# 3. Click "Set a new password"
SUBSTACK_EMAIL=your-email@example.com
SUBSTACK_PASSWORD=your-substack-password
SUBSTACK_PUBLICATION_URL=yourpublication.substack.com
