{
  "name": "news-radar",
  "version": "0.2.0",
  "description": "Predictive news intelligence CLI for detecting emerging stories",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "articles": "tsx src/articles-command.ts articles",
    "batch": "tsx src/batch-command.ts batch",
    "export": "tsx src/export-command.ts export",
    "tags": "tsx src/tags-command.ts",
    "voice": "tsx src/voice-command.ts",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "verify": "node verify.js",
    "write": "tsx src/write-command.ts write"
  },
  "keywords": [
    "news",
    "scraper",
    "cli",
    "trends",
    "emerging-stories"
  ],
  "author": "Joe Chrisman",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@supabase/supabase-js": "^2.84.0",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "dotenv": "^17.2.3",
    "node-fetch": "^3.3.2",
    "ora": "^8.0.1",
    "puppeteer": "^24.31.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
